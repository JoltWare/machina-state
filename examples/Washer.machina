    { "id": "t3", "source": "Washing", "target": "Rinsing", "event": "after(30s)", "guard": "", "action": "drain" },
    { "id": "t4", "source": "Rinsing", "target": "Spinning", "event": "after(20s)", "guard": "", "action": "" },
